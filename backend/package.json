{
  "name": "coopflow-backend",
  "version": "1.0.0",
  "description": "CoopFlow Backend - Cooperative Finance Platform powered by Stellar and Soroban",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "db:setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.0",
    "typeorm": "^0.3.20",
    "reflect-metadata": "^0.2.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "stellar-sdk": "^13.0.0",
    "bull": "^4.12.0",
    "ioredis": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.13.0",
    "nodemailer": "^6.9.0",
    "twilio": "^4.20.0",
    "uuid": "^9.0.0",
    "winston-daily-rotate-file": "^4.7.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "supertest": "^6.3.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.13",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "@types/multer": "^1.4.11",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.10.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0"
  }
}